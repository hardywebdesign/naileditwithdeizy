# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.
# See the README for where each value comes from.

# Keystatic Cloud project ("team/project"). Leave empty locally: the editor
# then saves straight to the files in this folder.
NEXT_PUBLIC_KEYSTATIC_PROJECT=

# Square production access token from Deizy's Square developer app.
# Without it, the Shop shows gallery sets with "Request this set" links.
SQUARE_ACCESS_TOKEN=
# Optional: SQUARE_LOCATION_ID=, SQUARE_ENVIRONMENT=sandbox

# Resend API key for the contact form. Without it, local dev logs messages
# to the terminal instead of emailing them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=deizaraejean@gmail.com
# CONTACT_FROM_EMAIL="Nailed It With Deizy <hello@naileditwithdeizy.com>"
CONTACT_FROM_EMAIL=

# The live address once the domain is connected
NEXT_PUBLIC_SITE_URL=
